2025-12-27T06:47:33.205Z CLI info [testhub:request-queue-handler]  [christianbuenvia_N9hiQw]  [cdwhsqrw8fcxzdl5c10fecaxzgisyakwylk1zinm]  [5040ab38-8245-4eb4-b54a-905316782709]  Added the event {
  event_type: 'TestRunStarted',
  test_run: {
    type: 'test',
    framework: 'WebdriverIO-mocha',
    uuid: 'b219717c-2498-4c41-9a1f-740588d1f859',
    name: 'should open BDO Online Banking and validate full page readiness',
    body: {
      lang: 'ecmascript',
      code: 'async function () {\n' +
        '        const caps = browser.capabilities;\n' +
        "        const device = caps.deviceName || caps.browserName || 'unknown-device';\n" +
        "        const os = caps.os || caps.platformName || 'unknown-os';\n" +
        "        const browserName = caps.browserName || 'unknown-browser';\n" +
        '        const isMobile = /ios|android/i.test(os) || /safari/i.test(browserName) || /chrome/i.test(browserName);\n' +
        '\n' +
        "        let status = 'passed';\n" +
        "        let title = 'N/A';\n" +
        "        let screenshotName = 'N/A';\n" +
        "        let softFailNote = '';\n" +
        '\n' +
        '        try {\n' +
        "            await browser.url('https://www.onlinebanking.bdo.com.ph/');\n" +
        '\n' +
        '            // 1️⃣ DOM + URL ready (soft-fail for mobile)\n' +
        '            try {\n' +
        '                await browser.waitUntil(\n' +
        '                    async () => {\n' +
        '                        const readyState = await browser.execute(() => document.readyState);\n' +
        '                        const currentUrl = await browser.getUrl();\n' +
        "                        return readyState === 'complete' && currentUrl.includes('bdo.com.ph');\n" +
        '                    },\n' +
        '                    { timeout: isMobile ? 90000 : 45000 }\n' +
        '                );\n' +
        '            } catch (domErr) {\n' +
        '                if (isMobile) {\n' +
        "                    softFailNote += '⚠ Mobile DOM may not be fully rendered; continuing as soft-fail<br/>';\n" +
        '                } else {\n' +
        '                    throw domErr;\n' +
        '                }\n' +
        '            }\n' +
        '\n' +
        '            // 2️⃣ Detect BLOCKED / SECURITY pages\n' +
        '            const pageContent = await browser.execute(() => document.body.innerText.toLowerCase());\n' +
        '            if (\n' +
        "                pageContent.includes('access denied') ||\n" +
        "                pageContent.includes('security check') ||\n" +
        "                pageContent.includes('unusual activity') ||\n" +
        "                pageContent.includes('verify you are human')\n" +
        '            ) {\n' +
        "                throw new Error('Blocked / security page detected');\n" +
        '            }\n' +
        '\n' +
        '            // 3️⃣ Detect MAINTENANCE page\n' +
        '            if (\n' +
        "                pageContent.includes('maintenance') ||\n" +
        "                pageContent.includes('temporarily unavailable') ||\n" +
        "                pageContent.includes('we’ll be back soon')\n" +
        '            ) {\n' +
        "                throw new Error('Maintenance page detected');\n" +
        '            }\n' +
        '\n' +
        '            // 4️⃣ Network idle approximation\n' +
        '            await browser.execute(() => {\n' +
        '                window.__lastNetworkActivity = Date.now();\n' +
        '                const origFetch = window.fetch;\n' +
        '                window.fetch = function () {\n' +
        '                    window.__lastNetworkActivity = Date.now();\n' +
        '                    return origFetch.apply(this, arguments);\n' +
        '                };\n' +
        '                const origXhrOpen = XMLHttpRequest.prototype.open;\n' +
        '                XMLHttpRequest.prototype.open = function () {\n' +
        "                    this.addEventListener('loadend', () => {\n" +
        '                        window.__lastNetworkActivity = Date.now();\n' +
        '                    });\n' +
        '                    origXhrOpen.apply(this, arguments);\n' +
        '                };\n' +
        '            });\n' +
        '\n' +
        '            try {\n' +
        '                await browser.waitUntil(\n' +
        '                    async () => {\n' +
        '                        const last = await browser.execute(() => window.__lastNetworkActivity);\n' +
        '                        return Date.now() - last > 3000; // 3s network idle\n' +
        '                    },\n' +
        '                    { timeout: 45000 }\n' +
        '                );\n' +
        '            } catch (netErr) {\n' +
        "                softFailNote += '⚠ Network idle not reached; continuing as soft-fail<br/>';\n" +
        '            }\n' +
        '\n' +
        '            // 5️⃣ Spinner wait (SOFT-FAIL for all mobile)\n' +
        '            try {\n' +
        '                await browser.waitUntil(\n' +
        '                    async () => {\n' +
        '                        return await browser.execute(() => {\n' +
        '                            const spinners = document.querySelectorAll(\n' +
        `                                '[class*="spinner"], [class*="loading"], [aria-busy="true"]'\n` +
        '                            );\n' +
        '                            return Array.from(spinners).every(el => {\n' +
        '                                const style = window.getComputedStyle(el);\n' +
        "                                return style.display === 'none' || style.visibility === 'hidden';\n" +
        '                            });\n' +
        '                        });\n' +
        '                    },\n' +
        '                    { timeout: 90000 } // extend to 90s for slow devices\n' +
        '                );\n' +
        '            } catch (spinnerErr) {\n' +
        "                softFailNote += '⚠ Spinner still visible (soft-fail)<br/>';\n" +
        '            }\n' +
        '\n' +
        '            // 6️⃣ Capture title\n' +
        '            title = await browser.getTitle();\n' +
        '\n' +
        '            // 7️⃣ Screenshot\n' +
        "            screenshotName = `${Date.now()}-${device.replace(/\\s/g, '_')}-BDO.png`;\n" +
        '            const screenshotPath = path.join(screenshotDir, screenshotName);\n' +
        '            await browser.saveScreenshot(screenshotPath);\n' +
        '\n' +
        '        } catch (err) {\n' +
        "            status = 'failed';\n" +
        '            throw err;\n' +
        '        } finally {\n' +
        '            // Prepare HTML report row\n' +
        '            if (!fs.existsSync(reportDir)) fs.mkdirSync(reportDir, { recursive: true });\n' +
        '            if (!fs.existsSync(screenshotDir)) fs.mkdirSync(screenshotDir, { recursive: true });\n' +
        '\n' +
        '            const finalStatus =\n' +
        "                status === 'passed' && softFailNote ? 'warning' : status;\n" +
        '\n' +
        '            const rowHtml = `<tr>\n' +
        '<td>${device}</td>\n' +
        '<td>${os}</td>\n' +
        '<td>${browserName}</td>\n' +
        "<td>${title}${softFailNote ? `<br/><small>${softFailNote}</small>` : ''}</td>\n" +
        '<td class="${finalStatus}">${finalStatus.toUpperCase()}</td>\n' +
        '<td>${\n' +
        "                screenshotName !== 'N/A'\n" +
        '                    ? `<a href="../screenshot/${screenshotName}" target="_blank">View</a>`\n' +
        "                    : 'N/A'\n" +
        '            }</td>\n' +
        '</tr>`;\n' +
        '\n' +
        '            fs.appendFileSync(reportFile, rowHtml);\n' +
        '        }\n' +
        '    }'
    },
    identifier: 'should open BDO Online Banking and validate full page readiness',
    scope: 'BDO Online Banking - Page Load Test - should open BDO Online Banking and validate full page readiness',
    scopes: [ 'BDO Online Banking - Page Load Test' ],
